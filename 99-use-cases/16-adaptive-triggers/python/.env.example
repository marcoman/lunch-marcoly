# Server-side SDK key used for evaluation and numeric custom metric events.
LD_SDK_KEY=sdk-...

# REST credentials used only by Start/Stop/status controls on the Python host.
LD_API_ACCESS_TOKEN=api-...
LD_PROJECT_KEY=lunch-marcoly
LD_ENVIRONMENT_KEY=production

# Optional overrides.
PORT=8161
# LD_API_HOST=https://app.launchdarkly.com
# LD_APP_HOST=https://app.launchdarkly.com
