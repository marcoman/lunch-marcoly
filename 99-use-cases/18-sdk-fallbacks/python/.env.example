# Server-side SDK key. It stays on the Python host.
LD_SDK_KEY=sdk-...

# Optional local ports.
PORT=8181
LD_STREAM_GATE_PORT=8182

# Initialization is deliberately bounded for the blocked-init scenario.
LD_START_WAIT=2

# Override only for a private LaunchDarkly deployment.
# LD_STREAM_ORIGIN=https://stream.launchdarkly.com
